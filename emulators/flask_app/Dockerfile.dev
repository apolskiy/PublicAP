FROM python:3.14.4-slim
WORKDIR /app

# Copy and install packages without saving bulky local cache files
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files. The build context is this directory, so .dockerignore
# beside this file is what keeps a local venv, caches and stray logs out of the image.
COPY . .

# Matching  existing application routing port
EXPOSE 4000

# Thin production execution syntax
CMD ["flask", "run", "--host=0.0.0.0", "--port=4000"]
